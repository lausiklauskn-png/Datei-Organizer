{
  "name": "datei-organizer",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "description": "Dateien in einen Ordner legen – der Datei-Organizer sortiert sie Sieb für Sieb und zeigt sie als Baum.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "probe:kern": "node scripts/run-kern-tests.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/run-kern-tests.mjs && node scripts/kern-js.mjs --pruefen && tsc --noEmit && vite build",
    "probe:ui": "node tests/ui-probe.mjs"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "pdfjs-dist": "4.10.38",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "tesseract.js": "^5.1.1",
    "typescript": "5.9.3",
    "vite": "6.4.1"
  }
}
